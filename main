"""Sistema simples de anúncios de compra e venda (terminal)."""

import json
from pathlib import Path

ARQUIVO = Path("anuncios.json")

# Cada categoria define os campos extras do anúncio.
# Formato de cada campo: (rótulo exibido, pergunta ao usuário, sufixo do valor)
CATEGORIAS = {
    "1": ("Casa", [
        ("Área", "Área em metros quadrados: ", " m²"),
        ("Quartos", "Quantidade de quartos: ", ""),
        ("Banheiros", "Quantidade de banheiros: ", ""),
        ("Garagem", "Possui garagem? ", ""),
    ]),
    "2": ("Carro", [
        ("Marca", "Marca: ", ""),
        ("Modelo", "Modelo: ", ""),
        ("Ano", "Ano: ", ""),
        ("Quilometragem", "Quilometragem: ", " km"),
        ("Cor", "Cor: ", ""),
        ("Combustível", "Combustível: ", ""),
    ]),
    "3": ("Moto", [
        ("Marca", "Marca: ", ""),
        ("Modelo", "Modelo: ", ""),
        ("Ano", "Ano: ", ""),
        ("Quilometragem", "Quilometragem: ", " km"),
        ("Cilindrada", "Cilindrada: ", ""),
    ]),
    "4": ("Van", [
        ("Marca", "Marca: ", ""),
        ("Modelo", "Modelo: ", ""),
        ("Ano", "Ano: ", ""),
        ("Quilometragem", "Quilometragem: ", " km"),
        ("Passageiros", "Quantidade de passageiros: ", ""),
    ]),
    "5": ("Barco", [
        ("Marca", "Marca: ", ""),
        ("Modelo", "Modelo: ", ""),
        ("Ano", "Ano: ", ""),
        ("Comprimento", "Comprimento em metros: ", " m"),
        ("Motor", "Motor: ", ""),
    ]),
    "6": ("Terreno", [
        ("Área", "Área em metros quadrados: ", " m²"),
        ("Bairro", "Bairro: ", ""),
    ]),
    "7": ("Sítio", [
        ("Área", "Área do sítio em metros quadrados: ", " m²"),
        ("Possui casa", "Possui casa? ", ""),
        ("Possui água", "Possui água? ", ""),
        ("Possui energia", "Possui energia elétrica? ", ""),
    ]),
}


# ---------- Persistência (salvar e carregar em arquivo) ----------

def carregar_anuncios():
    if not ARQUIVO.exists():
        return []
    try:
        return json.loads(ARQUIVO.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        print("Não foi possível ler anuncios.json. Começando com lista vazia.")
        return []


def salvar_anuncios(anuncios):
    texto = json.dumps(anuncios, ensure_ascii=False, indent=2)
    ARQUIVO.write_text(texto, encoding="utf-8")


# ---------- Entrada de dados com validação ----------

def ler_texto(pergunta):
    while True:
        valor = input(pergunta).strip()
        if valor:
            return valor
        print("Este campo não pode ficar vazio.")


def ler_preco():
    while True:
        texto = input("Preço: R$ ").strip().replace(",", ".")
        try:
            preco = float(texto)
        except ValueError:
            print("Digite um número válido, por exemplo 25000 ou 25000,50.")
            continue
        if preco <= 0:
            print("O preço deve ser maior que zero.")
            continue
        return preco


def formatar_preco(preco):
    texto = f"{preco:,.2f}"  # 25,000.50
    return "R$ " + texto.replace(",", "X").replace(".", ",").replace("X", ".")


# ---------- Exibição ----------

def mostrar_menu_categorias():
    for codigo, (tipo, _) in CATEGORIAS.items():
        print(f"{codigo} - {tipo}")


def mostrar_anuncio(anuncio):
    print("\n==============================")
    print("          ANÚNCIO")
    print("==============================")
    print("ID:", anuncio["id"])
    print("Tipo:", anuncio["tipo"])
    print("Nome:", anuncio["nome"])
    for rotulo, valor in anuncio["informacoes"].items():
        print(f"{rotulo}: {valor}")
    print("Preço:", formatar_preco(anuncio["preco"]))
    print("Cidade:", anuncio["cidade"])
    print("Descrição:", anuncio["descricao"])


def listar(anuncios, tipo=None):
    selecionados = [a for a in anuncios if tipo is None or a["tipo"] == tipo]
    if not selecionados:
        print("\nNenhum anúncio encontrado.")
        return
    for anuncio in selecionados:
        mostrar_anuncio(anuncio)


# ---------- Ações do menu ----------

def comprar(anuncios):
    print("\n==============================")
    print("          COMPRAR")
    print("==============================")
    mostrar_menu_categorias()
    print("8 - Ver todos")
    print("9 - Voltar")

    escolha = input("Escolha uma categoria: ")
    if escolha == "8":
        listar(anuncios)
    elif escolha == "9":
        print("\nVoltando ao menu...")
    elif escolha in CATEGORIAS:
        listar(anuncios, CATEGORIAS[escolha][0])
    else:
        print("\nCategoria inválida.")


def proximo_id(anuncios):
    # max() evita IDs repetidos mesmo se um dia houver exclusão de anúncios
    return max((a["id"] for a in anuncios), default=0) + 1


def vender(anuncios):
    print("\n==============================")
    print("         NOVO ANÚNCIO")
    print("==============================")
    mostrar_menu_categorias()

    escolha = input("O que você deseja vender? ")
    if escolha not in CATEGORIAS:
        print("\nTipo de anúncio inválido.")
        return

    tipo, campos = CATEGORIAS[escolha]
    print(f"\n--- CADASTRO DE {tipo.upper()} ---")

    anuncio = {
        "id": proximo_id(anuncios),
        "tipo": tipo,
        "nome": ler_texto("Nome do anúncio: "),
    }
    anuncio["informacoes"] = {
        rotulo: ler_texto(pergunta) + sufixo
        for rotulo, pergunta, sufixo in campos
    }
    anuncio["preco"] = ler_preco()
    anuncio["cidade"] = ler_texto("Cidade: ")
    anuncio["descricao"] = ler_texto("Descrição: ")

    anuncios.append(anuncio)
    salvar_anuncios(anuncios)

    print("\n==============================")
    print("ANÚNCIO CADASTRADO COM SUCESSO!")
    print("==============================")
    print("ID do anúncio:", anuncio["id"])


def main():
    anuncios = carregar_anuncios()

    while True:
        print("\n==============================")
        print("       COMPRA E VENDA")
        print("==============================")
        print("1 - Comprar")
        print("2 - Vender")
        print("3 - Meus anúncios")
        print("4 - Sair")

        opcao = input("Digite a opção: ")

        if opcao == "1":
            comprar(anuncios)
        elif opcao == "2":
            vender(anuncios)
        elif opcao == "3":
            # Ainda não há login: sem usuários, todos os anúncios aparecem aqui.
            print("\n==============================")
            print("        MEUS ANÚNCIOS")
            print("==============================")
            listar(anuncios)
        elif opcao == "4":
            print("\nSaindo do sistema...")
            break
        else:
            print("\nOpção inválida.")


if __name__ == "__main__":
    main()